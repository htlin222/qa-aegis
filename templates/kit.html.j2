<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ meta.title }} — {{ meta.subtitle or "Q&A Defense Kit" }}</title>
<style>
:root{--ink:#111;--mute:#555;--rule:#d6d6d6;--bg:#fff;--soft:#f4f4f4;--warn:#9a3412}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font:15px/1.55 Arial,Helvetica,sans-serif;color:var(--ink);background:var(--bg)}
a{color:inherit}
.layout{display:grid;grid-template-columns:240px 1fr;min-height:100vh}
nav.toc{position:sticky;top:0;align-self:start;height:100vh;overflow:auto;border-right:1px solid var(--rule);padding:20px 16px;font-size:13px}
nav.toc h2{font-size:12px;letter-spacing:.08em;text-transform:uppercase;margin:0 0 10px}
nav.toc a{display:block;text-decoration:none;padding:3px 0;color:var(--mute)}
nav.toc a:hover{color:var(--ink)}
nav.toc .sub{padding-left:12px}
main{padding:0 40px 80px;max-width:1100px}
header.cover{padding:40px 0 24px;border-bottom:2px solid var(--ink)}
header.cover h1{font-size:30px;margin:0 0 4px}
header.cover .sub{color:var(--mute)}
header.cover ol{margin:16px 0 0;padding-left:20px}
section{padding-top:28px}
section>h2{font-size:22px;border-bottom:1px solid var(--ink);padding-bottom:6px}
.bar{position:sticky;top:0;z-index:5;background:#fff;border-bottom:1px solid var(--rule);padding:10px 0;display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.bar input[type=search]{flex:1;min-width:200px;padding:7px 10px;border:1px solid var(--ink);font:inherit}
.bar select,.bar button,.bar label{font:inherit;font-size:13px}
.bar select{padding:6px;border:1px solid var(--ink);background:#fff}
.bar button{padding:6px 10px;border:1px solid var(--ink);background:#fff;cursor:pointer}
.bar button.on{background:var(--ink);color:#fff}
.count{color:var(--mute);font-size:13px}
table{border-collapse:collapse;width:100%;font-size:14px}
th,td{text-align:left;padding:6px 8px;border-bottom:1px solid var(--rule);vertical-align:top}
th{border-bottom:1px solid var(--ink);font-weight:700}
td.num{text-align:center}
.grid td.zero{color:#bbb}
.map{border:1px solid var(--rule);padding:12px;overflow:auto;background:#fff}
.map svg{max-width:100%;height:auto}
article.q{border-top:1px solid var(--rule);padding:18px 0}
article.q .meta{display:flex;flex-wrap:wrap;gap:6px;font-size:12px;align-items:center}
.chip{border:1px solid var(--ink);padding:1px 7px;border-radius:2px;white-space:nowrap}
.chip.id{background:var(--ink);color:#fff;font-weight:700}
.risk{letter-spacing:2px;font-size:12px}
.warnchip{border-color:var(--warn);color:var(--warn);font-weight:700}
article.q h3{font-size:18px;margin:8px 0 10px;line-height:1.35}
.principle{background:var(--ink);color:#fff;padding:10px 14px;margin:8px 0;font-weight:700}
.principle small{display:block;font-weight:400;font-size:11px;letter-spacing:.08em;text-transform:uppercase;opacity:.75}
.lbl{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--mute);margin:12px 0 2px;font-weight:700}
.answer{font-size:15.5px}
.fu{margin:4px 0 0;padding-left:16px;border-left:3px solid var(--ink)}
.fu p{margin:4px 0}
.shell{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:10px}
.shell>div{background:var(--soft);padding:10px 12px;font-size:14px}
.src{font-size:12.5px;color:var(--mute)}
.verify{color:var(--warn);font-weight:700;font-size:13px;margin-top:6px}
.hidden{display:none!important}
body.rehearse .reveal{display:none}
body.rehearse article.q.open .reveal{display:block}
body.rehearse article.q h3{cursor:pointer}
body.rehearse article.q h3::after{content:"  ▸ reveal";font-size:12px;color:var(--mute);font-weight:400}
body.rehearse article.q.open h3::after{content:"  ▾"}
.top td:first-child{font-weight:700;width:52px}
.legend{font-size:13px;color:var(--mute)}
@media print{nav.toc,.bar{display:none}.layout{display:block}article.q{break-inside:avoid}}
@media (max-width:820px){.layout{display:block}nav.toc{position:static;height:auto;border-right:0;border-bottom:1px solid var(--rule)}main{padding:0 16px 60px}.shell{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="layout">
<nav class="toc">
  <h2>Contents</h2>
  <a href="#overview">Overview</a>
  <a href="#top10">Top 10 risks</a>
  <a href="#map">Argument map</a>
  <a href="#coverage">MECE coverage</a>
  <a href="#cynefin">Cynefin triage</a>
  <a href="#questions">Questions</a>
  {% for b in branches %}<a class="sub" href="#b-{{ b.id }}">{{ b.label }} ({{ b.n }})</a>{% endfor %}
  <a href="#dose">Dose quick reference</a>
  <a href="#unverified">⚠ Unverified ({{ unverified|length }})</a>
  <a href="#refs">References</a>
</nav>
<main>
<header class="cover" id="overview">
  <div class="sub">{{ meta.subtitle or "Q&A Defense Kit" }}</div>
  <h1>{{ meta.title }}</h1>
  <div class="sub">{{ meta.speaker or "" }}{% if meta.talk_date %} · Talk {{ meta.talk_date }}{% endif %} · Sources checked {{ meta.checked }} · {{ questions|length }} questions</div>
  {% if meta.core_claims %}<ol>{% for c in meta.core_claims %}<li>{{ c }}</li>{% endfor %}</ol>{% endif %}
</header>

<section id="top10">
  <h2>Top 10 risks</h2>
  <table class="top"><thead><tr><th>ID</th><th>Question</th><th>Core answer</th><th>Risk</th></tr></thead><tbody>
  {% for q in top10 %}<tr><td><a href="#{{ q.id }}">{{ q.id }}</a></td><td>{{ q.q }}</td><td>{{ q._one }}</td><td class="num">{{ q.risk }}</td></tr>{% endfor %}
  </tbody></table>
</section>

<section id="map">
  <h2>Argument map</h2>
  <p class="legend">Core claims, their support (green arrows) and attacks (red arrows). Attack types: rebut = the conclusion; undercut = the inference; undermine = a premise. Every attack is answered by at least one question below.</p>
  {% for mp in maps %}<h3 style="font-size:15px;margin:18px 0 6px">{{ loop.index }}. {{ mp.claim or mp.title }}</h3><div class="map">{{ mp.svg|safe }}</div>{% endfor %}
</section>

<section id="coverage">
  <h2>MECE coverage</h2>
  <table class="grid"><thead><tr><th>Branch</th>{% for p in personas %}<th class="num">{{ p.label }}</th>{% endfor %}<th class="num">Total</th></tr></thead><tbody>
  {% for b in branches %}<tr><td><b>{{ b.label }}</b><br><span class="legend">{{ b.root }}</span></td>{% for p in personas %}{% set n = grid[b.id][p.id] %}<td class="num{% if not n %} zero{% endif %}">{{ n or "·" }}</td>{% endfor %}<td class="num"><b>{{ b.n }}</b></td></tr>{% endfor %}
  <tr><td><b>Total</b></td>{% for p in personas %}<td class="num"><b>{{ p.n }}</b></td>{% endfor %}<td class="num"><b>{{ questions|length }}</b></td></tr>
  </tbody></table>
</section>

<section id="cynefin">
  <h2>Cynefin triage</h2>
  <table><thead><tr><th>Domain</th><th>Opener</th><th class="num">n</th><th>Questions</th></tr></thead><tbody>
  {% for c in cynefin %}<tr><td><b>{{ c.label }}</b></td><td>“{{ c.opener }}”</td><td class="num">{{ c.ids|length }}</td><td class="legend">{% for i in c.ids %}<a href="#{{ i }}">{{ i }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</td></tr>{% endfor %}
  </tbody></table>
</section>

<section id="questions">
  <h2>Questions</h2>
  <div class="bar">
    <input type="search" id="qs" placeholder="Search questions, answers, principles…">
    <select id="fb"><option value="">All branches</option>{% for b in branches %}<option value="{{ b.id }}">{{ b.label }}</option>{% endfor %}</select>
    <select id="fp"><option value="">All personas</option>{% for p in personas %}<option value="{{ p.id }}">{{ p.label }}</option>{% endfor %}</select>
    <select id="fc"><option value="">All domains</option>{% for c in cynefin %}<option value="{{ c.id }}">{{ c.label }}</option>{% endfor %}</select>
    <select id="fr"><option value="0">Any risk</option><option value="5">Risk 5</option><option value="4">Risk ≥4</option><option value="3">Risk ≥3</option></select>
    <button id="rh" title="Hide answers; click a question to reveal">Rehearsal mode</button>
    <span class="count" id="cnt"></span>
  </div>
  {% for b in branches %}
  <h2 id="b-{{ b.id }}" class="bh" data-branch="{{ b.id }}" style="font-size:18px;border:0;margin-top:26px">{{ b.label }} — <span style="font-weight:400">{{ b.root }}</span></h2>
  {% for q in b.questions %}
  <article class="q" id="{{ q.id }}" data-branch="{{ q.branch }}" data-persona="{{ q.persona }}" data-cynefin="{{ q.cynefin }}" data-risk="{{ q.risk }}">
    <div class="meta"><span class="chip id">{{ q.id }}</span><span class="chip">{{ persona_label[q.persona] }}</span><span class="chip">{{ cynefin_label[q.cynefin] }}</span>{% if q.attack %}<span class="chip">{{ q.attack }}</span>{% endif %}<span class="risk" title="risk {{ q.risk }}/5">{{ "●" * q.risk }}{{ "○" * (5 - q.risk) }}</span>{% if q.verify %}<span class="chip warnchip">⚠ UNVERIFIED</span>{% endif %}</div>
    <h3>{{ q.q }}</h3>
    <div class="reveal">
      <div class="principle"><small>First principle</small>{{ q.principle }}</div>
      <div class="lbl">30-second answer</div>
      <div class="answer">{{ q.answer }}</div>
      {% if q.followups %}<div class="lbl">Follow-ups</div><div class="fu">{% for f in q.followups %}<p><b>{{ f.q }}</b><br>{{ f.a }}</p>{% endfor %}</div>{% endif %}
      {% if q.ai_answer %}<div class="shell"><div><div class="lbl" style="margin-top:0">What the AI told them</div>{{ q.ai_answer }}</div><div><div class="lbl" style="margin-top:0">Blind spot</div>{{ q.blind_spot }}</div></div>{% endif %}
      {% if q.sources %}<div class="lbl">Sources</div><div class="src">{% for s in q.sources %}<a href="{{ src[s].url }}" target="_blank" rel="noopener">[{{ s }}]</a> {{ src[s].cite }}{% if not loop.last %}<br>{% endif %}{% endfor %}</div>{% endif %}
      {% if q.verify %}<div class="verify">⚠ UNVERIFIED — {{ q.verify }}</div>{% endif %}
    </div>
  </article>
  {% endfor %}{% endfor %}
</section>

<section id="dose">
  <h2>Dose quick reference</h2>
  <table><thead><tr><th>Item</th><th>Value</th><th>Source</th></tr></thead><tbody>
  {% for r in dose_table %}<tr><td><b>{{ r.item }}</b></td><td>{{ r.value }}{% if r.verify %}<div class="verify">⚠ {{ r.verify }}</div>{% endif %}</td><td class="src">{% if r.source %}<a href="{{ src[r.source].url }}" target="_blank" rel="noopener">{{ r.source }}</a>{% endif %}</td></tr>{% endfor %}
  </tbody></table>
</section>

<section id="unverified">
  <h2>⚠ Unverified — check before the talk</h2>
  <table><tbody>{% for k, v in unverified %}<tr><td style="width:120px"><b>{% if k in qids %}<a href="#{{ k }}">{{ k }}</a>{% else %}{{ k }}{% endif %}</b></td><td>{{ v }}</td></tr>{% endfor %}</tbody></table>
</section>

<section id="refs">
  <h2>References</h2>
  <table><tbody>{% for s in sources %}<tr><td style="width:48px"><b>{{ s.id }}</b></td><td>{{ s.cite }}<br><span class="src"><a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.url }}</a>{% if s.read %} · read: {{ s.read }}{% endif %}</span></td></tr>{% endfor %}</tbody></table>
</section>
</main>
</div>
<script>
(function(){
  var $=function(s){return document.querySelector(s)}, arts=[].slice.call(document.querySelectorAll('article.q')), heads=[].slice.call(document.querySelectorAll('h2.bh'));
  function apply(){
    var t=$('#qs').value.toLowerCase(), b=$('#fb').value, p=$('#fp').value, c=$('#fc').value, r=+$('#fr').value, n=0, seen={};
    arts.forEach(function(a){
      var ok=(!b||a.dataset.branch===b)&&(!p||a.dataset.persona===p)&&(!c||a.dataset.cynefin===c)&&(+a.dataset.risk>=r)&&(!t||a.textContent.toLowerCase().indexOf(t)>-1);
      a.classList.toggle('hidden',!ok); if(ok){n++;seen[a.dataset.branch]=1}
    });
    heads.forEach(function(h){h.classList.toggle('hidden',!seen[h.dataset.branch])});
    $('#cnt').textContent=n+' shown';
  }
  ['#qs','#fb','#fp','#fc','#fr'].forEach(function(s){$(s).addEventListener('input',apply)});
  $('#rh').addEventListener('click',function(){document.body.classList.toggle('rehearse');this.classList.toggle('on')});
  arts.forEach(function(a){a.querySelector('h3').addEventListener('click',function(){if(document.body.classList.contains('rehearse'))a.classList.toggle('open')})});
  apply();
})();
</script>
</body>
</html>
